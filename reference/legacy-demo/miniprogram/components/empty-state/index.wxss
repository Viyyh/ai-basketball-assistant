.empty {
  padding: 100rpx var(--sp-4) 60rpx;
  text-align: center;
}
.empty__icon {
  width: 130rpx;
  height: 130rpx;
  margin: 0 auto var(--sp-3);
  border: 3rpx dashed var(--line);
  border-radius: var(--r-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  color: var(--ink-3);
  background: var(--card);
}
.empty__title {
  font-size: var(--fs-md);
  color: var(--ink-2);
  font-weight: 500;
  margin-bottom: var(--sp-1);
}
.empty__desc {
  font-size: var(--fs-sm);
  color: var(--ink-3);
  line-height: 1.7;
  margin-bottom: var(--sp-4);
  max-width: 520rpx;
  margin-left: auto;
  margin-right: auto;
}
.empty__btn {
  display: inline-flex;
  width: auto;
  min-width: 300rpx;
  padding: var(--sp-2) var(--sp-5);
  font-size: var(--fs-md);
  line-height: 1.5;
}
.empty__btn::after { border: none; }
