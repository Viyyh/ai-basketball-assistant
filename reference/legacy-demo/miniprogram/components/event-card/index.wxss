.ev {
  display: flex;
  align-items: center;
  gap: var(--sp-2);
  background: var(--card);
  border: 2rpx solid var(--line-2);
  border-radius: var(--r-md);
  padding: var(--sp-2);
  margin-bottom: var(--sp-1);
}

/* 未补录：橙色左边线 + 底色，一眼可见（界面设计 v0.1.1 屏 07） */
.ev--pending {
  border-color: var(--warn);
  border-left-width: 8rpx;
  background: #fffbeb;
}
.ev--done { border-color: var(--line-2); }
.ev--hover { background: var(--fill); }

.ev__thumb {
  position: relative;
  width: 108rpx;
  height: 72rpx;
  border-radius: var(--r-sm);
  background: var(--fill-2);
  flex-shrink: 0;
  overflow: hidden;
}
.ev__thumb-img { width: 100%; height: 100%; }
.ev__thumb-ph {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: var(--ink-3);
}
.ev__made {
  position: absolute;
  right: 4rpx; top: 4rpx;
  width: 26rpx; height: 26rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 16rpx; color: #fff;
}
.ev__made--y { background: var(--ok); }
.ev__made--n { background: var(--err); }

.ev__body { flex: 1; min-width: 0; }
.ev__title {
  font-size: var(--fs-md);
  font-weight: 500;
  color: var(--ink);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.ev__time { font-size: var(--fs-xs); color: var(--ink-3); margin-top: 2rpx; }
.ev__meta {
  font-size: var(--fs-xs); color: var(--ink-3); margin-top: 2rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.ev__who {
  flex-shrink: 0;
  display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx;
  max-width: 180rpx;
}
.ev__name {
  font-size: var(--fs-sm); color: var(--ink-2);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  max-width: 180rpx;
}
/* 未归属显示「—」，不显示 0 或空（PRD 3.6） */
.ev__name--na { color: var(--warn-ink); }
