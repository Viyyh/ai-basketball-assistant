.pd-loading { padding: 160rpx 0; text-align: center; color: var(--ink-3); font-size: var(--fs-sm); }

.pd-head { margin: var(--sp-3); padding: var(--sp-3); }
.pd-head__row { display: flex; align-items: center; gap: var(--sp-3); }
.pd-head__num {
  width: 104rpx; height: 104rpx; border-radius: 50%;
  background: var(--mod-player-2); color: var(--mod-player);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 600; flex-shrink: 0;
}
.pd-head__main { flex: 1; min-width: 0; }
.pd-head__name { font-size: 34rpx; font-weight: 600; color: var(--ink); }
.pd-head__sub { font-size: var(--fs-sm); color: var(--ink-3); margin-top: 4rpx; }
.pd-head__tags { display: flex; gap: 8rpx; margin-top: var(--sp-1); }

.pd-scopes { display: flex; flex-wrap: wrap; gap: var(--sp-1); padding: 0 var(--sp-3); }
.pd-scope { margin: var(--sp-2) var(--sp-3) 0; }

.pd-metrics { padding: 0 var(--sp-3); }
.pd-note {
  padding: var(--sp-1) var(--sp-3) 0;
  font-size: var(--fs-xs); color: var(--ink-3); line-height: 1.6;
}

.pd-court { padding: 0 var(--sp-3); }
.pd-court-note {
  padding: var(--sp-1) var(--sp-3) 0;
  font-size: var(--fs-xs); color: var(--ink-3); line-height: 1.6; text-align: center;
}

.pd-legend {
  display: flex; gap: var(--sp-3); justify-content: center;
  padding: var(--sp-2) var(--sp-3) 0;
  font-size: var(--fs-xs); color: var(--ink-3);
}
.pd-legend__item { display: flex; align-items: center; gap: 6rpx; }
.pd-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.pd-dot--made { background: var(--ok); }
.pd-dot--miss { background: var(--err); }

.pd-zones { padding: var(--sp-3); }
.stat__sub { font-size: 18rpx; color: var(--ink-3); margin-top: 2rpx; }
.stat--na { opacity: 0.5; }

.pd-trend { margin: 0 var(--sp-3) var(--sp-3); padding: var(--sp-2); }
.pd-chart { width: 100%; height: 140rpx; }
.pd-trend__labels {
  display: flex; justify-content: space-between;
  font-size: 18rpx; color: var(--ink-3); margin-top: 4rpx;
}

.pd-log { padding: 0 var(--sp-3); }
