.fm-loading { padding: 160rpx 0; text-align: center; color: var(--ink-3); font-size: var(--fs-sm); }
.fm-scope { padding: var(--sp-2) var(--sp-3) 0; }

.fm-scopes { white-space: nowrap; padding: 0 var(--sp-3) var(--sp-2); display: flex; }
.fm-scopes .fchip { margin-right: var(--sp-1); flex-shrink: 0; }

.fm-court { padding: 0 var(--sp-3); }

.fm-label {
  margin: var(--sp-3);
  text-align: center;
  background: var(--accent-2);
  border-color: var(--accent);
  border-style: solid;
  padding: var(--sp-3);
}
.fm-label__cap { font-size: var(--fs-xs); color: var(--ink-3); }
.fm-label__name { font-size: var(--fs-lg); font-weight: 600; color: var(--accent); margin-top: 4rpx; }
.fm-label__name--na { color: var(--ink-3); font-weight: 500; }
.fm-label__conf { font-size: var(--fs-xs); color: var(--ink-3); margin-top: 4rpx; line-height: 1.5; }
.fm-label__pts { font-size: var(--fs-xs); color: var(--ink-3); margin-top: var(--sp-1); opacity: 0.8; }

.fm-scrub { padding: 0 var(--sp-3); }
.fm-scrub__labels {
  display: flex; justify-content: space-between;
  font-size: var(--fs-xs); color: var(--ink-3); margin-bottom: 4rpx;
}
.fm-scrub__idx { color: var(--accent); }
.fm-acts { margin-top: var(--sp-2); }
.fm-collect { margin-top: var(--sp-2); }

.fm-hint {
  padding: var(--sp-3) var(--sp-4) var(--sp-6);
  font-size: var(--fs-xs); color: var(--ink-3); line-height: 1.7; text-align: center;
}
