.rp-loading { padding: 160rpx 0; text-align: center; color: var(--ink-3); font-size: var(--fs-sm); }

.rp-scope { padding: var(--sp-2) var(--sp-3) 0; }
.rp-warn { margin: var(--sp-2) var(--sp-3) 0; }
.rp-warn__line { line-height: 1.7; }

/* 标定阻断态 */
.rp-block { padding: 100rpx var(--sp-5) 0; text-align: center; }
.rp-block__icon {
  width: 120rpx; height: 120rpx; margin: 0 auto var(--sp-3);
  border-radius: 50%; background: var(--err-2); color: var(--err);
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; font-weight: 600;
}
.rp-block__title { font-size: var(--fs-xl); font-weight: 600; margin-bottom: var(--sp-1); }
.rp-block__desc { font-size: var(--fs-sm); color: var(--ink-2); margin-bottom: var(--sp-3); }
.rp-block__why {
  font-size: var(--fs-xs); color: var(--ink-3); line-height: 1.7;
  text-align: left; background: var(--fill);
  border-radius: var(--r-md); padding: var(--sp-3);
}

/* 比分卡 */
.scorecard {
  margin: var(--sp-3);
  padding: var(--sp-4) var(--sp-3);
  background: linear-gradient(90deg, #1e293b, #334155);
  color: #fff;
  border-radius: var(--r-lg);
}
.scorecard__teams { display: flex; align-items: center; justify-content: space-between; }
.scorecard__team { flex: 1; font-size: var(--fs-sm); opacity: 0.85; }
.scorecard__team--r { text-align: right; }
.scorecard__score { font-size: 56rpx; font-weight: 600; line-height: 1.1; padding: 0 var(--sp-1); }
.scorecard__vs { opacity: 0.5; font-size: var(--fs-md); }
.scorecard__meta {
  font-size: var(--fs-xs); opacity: 0.7; text-align: center; margin-top: var(--sp-2);
}
.scorecard__note {
  font-size: var(--fs-xs); opacity: 0.85; text-align: center; margin-top: 6rpx;
  background: rgba(255,255,255,0.12); border-radius: var(--r-pill);
  padding: 2rpx 16rpx; display: inline-block;
}
.scorecard { text-align: center; }

/* 时间轴 */
.tl { display: flex; gap: 6rpx; padding: 0 var(--sp-3); }
.tl__seg { flex: 1; }
.tl__band {
  position: relative; height: 64rpx;
  background: var(--fill-2); border-radius: var(--r-sm);
  overflow: hidden;
}
.tl__mark {
  position: absolute; top: 0; bottom: 0; width: 4rpx;
}
.tl__mark--made { background: var(--ok); }
.tl__mark--miss { background: var(--err); }
.tl__mark--neutral { background: var(--ink-3); }
.tl__label { text-align: center; font-size: var(--fs-xs); color: var(--ink-3); margin-top: 6rpx; }
.tl__count { text-align: center; font-size: 18rpx; color: var(--ink-3); opacity: 0.7; }
.tl-hint {
  padding: var(--sp-1) var(--sp-3) 0;
  font-size: var(--fs-xs); color: var(--ink-3);
}

/* 指标 */
.rp-metrics { padding: 0 var(--sp-3); }
.stat__sub { font-size: 18rpx; color: var(--ink-3); margin-top: 2rpx; }
.stat--na { opacity: 0.55; }
.rp-mnote {
  padding: var(--sp-1) var(--sp-3) var(--sp-3);
  font-size: var(--fs-xs); color: var(--ink-3); line-height: 1.6;
}

/* 入口卡 */
.rp-entries {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: var(--sp-2); padding: 0 var(--sp-3);
}
.rp-entry { padding: var(--sp-3); margin-bottom: 0; }
.rp-entry--hover { opacity: 0.85; }
.rp-entry--warn { background: var(--warn-2); border-color: var(--warn); border-style: solid; }
.rp-entry--disabled { opacity: 0.5; }
.rp-entry__icon { font-size: 40rpx; line-height: 1; }
.rp-entry__title { font-size: var(--fs-md); font-weight: 600; margin-top: var(--sp-1); }
.rp-entry--warn .rp-entry__title { color: var(--warn-ink); }
.rp-entry__sub { font-size: var(--fs-xs); color: var(--ink-3); margin-top: 4rpx; }
.rp-entry--warn .rp-entry__sub { color: var(--warn-ink); opacity: 0.85; }

/* 补录进度条 */
.rp-attr {
  margin: var(--sp-4) var(--sp-3) var(--sp-4);
  padding: var(--sp-3);
  background: var(--warn-2);
  border: 2rpx solid var(--warn);
  border-radius: var(--r-lg);
}
.rp-attr__row { display: flex; align-items: center; justify-content: space-between; }
.rp-attr__text { font-size: var(--fs-md); font-weight: 600; color: var(--warn-ink); }
.rp-attr__cta { font-size: var(--fs-sm); color: var(--warn-ink); text-decoration: underline; }
.rp-attr__track {
  height: 10rpx; background: rgba(255,255,255,0.75);
  border-radius: 5rpx; overflow: hidden; margin-top: var(--sp-2);
}
.rp-attr__fill { height: 100%; background: var(--warn); border-radius: 5rpx; }
.rp-attr__note { font-size: var(--fs-xs); color: var(--warn-ink); opacity: 0.85; margin-top: var(--sp-1); }
.rp-attr-done { margin: var(--sp-4) var(--sp-3); }
