<video id="game" src="{{video}}" controls bindtimeupdate="time" binderror="videoError"/><view class="muted">当前 {{seconds}} 秒 · 仅代表测试片段，非整场数据</view><view class="card"><view>确认当前时刻的一次出手</view><picker range="{{teams}}" bindchange="team"><view class="row">球队：{{teams[teamIndex]}}</view></picker><picker range="{{values}}" bindchange="points"><view class="row">分值：{{values[pointIndex]}}</view></picker><view class="row">命中<switch checked="{{made}}" bindchange="made"/></view><button bindtap="save" loading="{{saving}}" disabled="{{saving}}">记录投篮</button></view><view class="card"><view>{{warning}}</view><view wx:for="{{summary}}" wx:key="name" class="row">{{item.name}}：{{item.made}} / {{item.attempts}} · {{item.points}} 分</view></view><view class="card" wx:for="{{events}}" wx:key="id"><view data-seconds="{{item.seconds}}" bindtap="seek">▶ {{item.seconds}} 秒 · {{item.team==='home'?'主队':'客队'}} · {{item.points}} 分 · {{item.made?'命中':'未中'}}</view><button size="mini" data-id="{{item.id}}" bindtap="remove">撤销记录</button></view>
