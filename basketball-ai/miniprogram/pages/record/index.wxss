.rec-page {
  position: relative;
  width: 100%;
  height: 100vh;
  background: #0f172a;
  overflow: hidden;
}

.rec-cam { position: absolute; inset: 0; width: 100%; height: 100%; }
.rec-cam--placeholder { background: #1e293b; }

/* 顶部信息条 */
.rec-top {
  position: absolute; top: 0; left: 0; right: 0;
  padding: calc(var(--sp-3) + env(safe-area-inset-top)) var(--sp-3) var(--sp-2);
  display: flex; align-items: center; justify-content: space-between;
  background: linear-gradient(180deg, rgba(15,23,42,0.75), rgba(15,23,42,0));
  z-index: 3;
}
.rec-idle {
  font-size: var(--fs-sm); color: #94a3b8;
  padding: 4rpx 16rpx; border-radius: var(--r-pill);
  background: rgba(148,163,184,0.18);
}
.rec-dev { font-size: var(--fs-xs); color: #94a3b8; display: flex; gap: 6rpx; }
.rec-dev--low { color: #fca5a5; font-weight: 600; }
.rec-dev__sep { opacity: 0.5; }

/* 活动名与口径 */
.rec-meta {
  position: absolute; top: calc(96rpx + env(safe-area-inset-top)); left: var(--sp-3); right: var(--sp-3);
  z-index: 3;
}
.rec-meta__name { font-size: var(--fs-sm); color: #cbd5e1; }
.rec-meta__scope { font-size: var(--fs-xs); color: #64748b; margin-top: 2rpx; }

/* 告警条 */
.rec-alert {
  position: absolute; left: var(--sp-3); right: var(--sp-3);
  top: calc(170rpx + env(safe-area-inset-top));
  padding: var(--sp-2);
  border-radius: var(--r-md);
  font-size: var(--fs-xs);
  line-height: 1.5;
  z-index: 3;
}
.rec-alert--warn { background: rgba(245,158,11,0.92); color: #451a03; }
.rec-alert--err  { background: rgba(220,38,38,0.92); color: #fff; }

/* 稳定性提示 */
.rec-tip {
  position: absolute; top: 42%; left: 0; right: 0;
  text-align: center; z-index: 2; pointer-events: none;
}
.rec-tip__main {
  font-size: var(--fs-lg); color: rgba(255,255,255,0.72); font-weight: 500;
}
.rec-tip__sub { font-size: var(--fs-xs); color: rgba(255,255,255,0.42); margin-top: 6rpx; }

/* 套路标记浮动按钮 */
.rec-mark {
  position: absolute; right: var(--sp-3);
  bottom: calc(280rpx + var(--safe-bottom));
  z-index: 4; text-align: center;
}
.rec-mark__btn {
  padding: var(--sp-2) var(--sp-3);
  background: rgba(124,58,237,0.92); color: #fff;
  border-radius: var(--r-pill);
  font-size: var(--fs-sm); font-weight: 500;
}
.rec-mark__btn--on { background: rgba(245,158,11,0.95); color: #451a03; }
.rec-mark__count { font-size: 18rpx; color: rgba(255,255,255,0.6); margin-top: 6rpx; }

/* 底部控制 */
.rec-bottom {
  position: absolute; left: 0; right: 0;
  bottom: calc(var(--sp-5) + var(--safe-bottom));
  display: flex; flex-direction: column; align-items: center; gap: var(--sp-2);
  z-index: 4;
}
.rec-start {
  min-width: 320rpx;
  padding: var(--sp-3) var(--sp-6);
  font-size: var(--fs-lg);
}
.rec-stop {
  width: 132rpx; height: 132rpx; border-radius: 50%;
  background: var(--err); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
  box-shadow: 0 0 0 14rpx rgba(220,38,38,0.2);
}
.rec-stop--busy { opacity: 0.6; }
.rec-hint { font-size: var(--fs-xs); color: rgba(255,255,255,0.55); }

/* 可恢复提示 */
.rec-recover {
  position: absolute; left: var(--sp-3); right: var(--sp-3);
  bottom: calc(240rpx + var(--safe-bottom));
  background: rgba(30,41,59,0.94);
  border: 2rpx solid rgba(148,163,184,0.35);
  border-radius: var(--r-md);
  padding: var(--sp-2) var(--sp-3);
  z-index: 4;
}
.rec-recover__text { font-size: var(--fs-xs); color: #cbd5e1; line-height: 1.6; margin-bottom: 6rpx; }
.linkbtn { font-size: var(--fs-sm); color: #93c5fd; }
.linkbtn--dim { color: #64748b; }

/* 合规浮层 */
.consent { background: #0f172a; color: #e2e8f0; }
.consent .sheet__handle { background: #475569; }
.consent .sheet__title { color: #fff; }
.consent__body { margin-bottom: var(--sp-3); }
.consent__lead { font-size: var(--fs-sm); color: #e2e8f0; line-height: 1.7; margin-bottom: var(--sp-2); }
.consent__item { font-size: var(--fs-sm); color: #cbd5e1; line-height: 1.9; }
.consent__item--dim { color: #94a3b8; font-size: var(--fs-xs); margin-top: var(--sp-1); }
.consent .btn--ghost { border-color: #475569; color: #94a3b8; }
