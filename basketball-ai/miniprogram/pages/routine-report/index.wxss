.rt-loading { padding: 160rpx 0; text-align: center; color: var(--ink-3); font-size: var(--fs-sm); }
.rt-scope { padding: var(--sp-2) var(--sp-3) 0; }

.rt-summary { margin: var(--sp-2) var(--sp-3); padding: var(--sp-3); }
.rt-summary__row { display: flex; }
.rt-summary__cell { flex: 1; text-align: center; }
.rt-summary__n { font-size: var(--fs-xl); font-weight: 600; color: var(--ink); }
.rt-summary__l { font-size: var(--fs-xs); color: var(--ink-3); margin-top: 4rpx; }

.rt-unclassified { margin: 0 var(--sp-3) var(--sp-2); }
.rt-unclassified__n { font-size: var(--fs-xs); margin-top: 6rpx; opacity: 0.8; }

/* 套路项 */
.rt-item { margin: 0 var(--sp-3) var(--sp-2); padding: 0; overflow: hidden; }
.rt-item--ok   { border-left: 8rpx solid var(--ok); }
.rt-item--warn { border-left: 8rpx solid var(--warn); }
.rt-item--err  { border-left: 8rpx solid var(--err); }
.rt-item--na   { border-left: 8rpx solid var(--line); }

.rt-item__hd { display: flex; align-items: center; gap: var(--sp-2); padding: var(--sp-3); }
.rt-item__main { flex: 1; min-width: 0; }
.rt-item__name { font-size: var(--fs-md); font-weight: 600; color: var(--ink); }
.rt-item__meta { font-size: var(--fs-xs); color: var(--ink-3); margin-top: 4rpx; }
.rt-item__warn { font-size: var(--fs-xs); color: var(--warn-ink); margin-top: 4rpx; }
.rt-item__range { font-size: var(--fs-xs); color: var(--accent); margin-top: 4rpx; }
.rt-item__rate { text-align: right; flex-shrink: 0; }
.rt-item__arrow { font-size: var(--fs-xs); color: var(--ink-3); margin-top: 6rpx; }

.rt-item__edit {
  display: flex; gap: var(--sp-1);
  padding: 0 var(--sp-3) var(--sp-2);
}
.rt-edit__btn {
  flex: 1; text-align: center;
  padding: 8rpx; font-size: var(--fs-xs);
  border: 2rpx solid var(--line-2); border-radius: var(--r-sm);
  color: var(--ink-2); background: var(--fill);
}

.rt-item__body { padding: 0 var(--sp-3) var(--sp-3); border-top: 2rpx solid var(--line-2); }
.rt-clip {
  display: flex; align-items: center; gap: var(--sp-2);
  padding: var(--sp-2) 0;
  border-bottom: 2rpx solid var(--line-2);
}
.rt-clip:last-child { border-bottom: none; }
.rt-clip__ph {
  width: 72rpx; height: 48rpx; border-radius: var(--r-sm);
  background: #1e293b; color: #94a3b8;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; flex-shrink: 0;
}
.rt-clip__body { flex: 1; min-width: 0; }
.rt-clip__t { font-size: var(--fs-sm); color: var(--ink); }
.rt-clip__s { font-size: var(--fs-xs); color: var(--ink-3); margin-top: 2rpx; }
.rt-clip__arrow { color: var(--ink-3); font-size: var(--fs-lg); }
.rt-clip__empty { padding: var(--sp-3) 0; font-size: var(--fs-xs); color: var(--ink-3); line-height: 1.7; }

.rt-add { margin: var(--sp-3); width: auto; }
.rt-note {
  padding: 0 var(--sp-4) var(--sp-6);
  font-size: var(--fs-xs); color: var(--ink-3); line-height: 1.7; text-align: center;
}
.rt-empty { padding-top: var(--sp-3); }
.rt-swap { display: inline-block; margin-top: var(--sp-1); }
.linkbtn { font-size: var(--fs-sm); color: var(--accent); }
