/**
 * 设计系统 · 公共类 —— P1-F01
 *
 * 对应 PRD 3.4「交互模式约定」与 3.6「空状态策略」。
 * 所有页面统一引用，不得各页自定义一套。
 */

@import "./variables.wxss";

/* ============================================================
   基础
   ============================================================ */

page {
  background: var(--bg);
  color: var(--ink);
  font-size: var(--fs-md);
  line-height: 1.6;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(var(--nav-h) + var(--safe-bottom));
  box-sizing: border-box;
}

.page--flush { padding-bottom: 0; }

.row { display: flex; align-items: center; }
.row--between { display: flex; align-items: center; justify-content: space-between; }
.row--gap1 { display: flex; align-items: center; gap: var(--sp-1); }
.row--gap2 { display: flex; align-items: center; gap: var(--sp-2); }
.col { display: flex; flex-direction: column; }
.col--gap1 { display: flex; flex-direction: column; gap: var(--sp-1); }
.col--gap2 { display: flex; flex-direction: column; gap: var(--sp-2); }
.flex1 { flex: 1; min-width: 0; }
.wrap { flex-wrap: wrap; }

/* ============================================================
   文本
   ============================================================ */

.t-title   { font-size: var(--fs-xl); font-weight: 600; color: var(--ink); }
.t-h       { font-size: var(--fs-lg); font-weight: 600; color: var(--ink); }
.t-body    { font-size: var(--fs-md); color: var(--ink-2); }
.t-sub     { font-size: var(--fs-sm); color: var(--ink-3); }
.t-xs      { font-size: var(--fs-xs); color: var(--ink-3); }
.t-num     { font-size: var(--fs-num); font-weight: 600; line-height: 1.2; }
.t-strong  { font-weight: 600; }
.t-center  { text-align: center; }
.t-right   { text-align: right; }
.t-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.t-accent { color: var(--accent); }
.t-ok     { color: var(--ok); }
.t-warn   { color: var(--warn-ink); }
.t-err    { color: var(--err); }
.t-muted  { color: var(--ink-3); }

.sec-label {
  font-size: var(--fs-sm);
  color: var(--ink-3);
  margin: var(--sp-4) 0 var(--sp-2);
}

.req { color: var(--err); font-weight: 600; }

/* ============================================================
   卡片
   ============================================================ */

.card {
  background: var(--card);
  border: 2rpx solid var(--line-2);
  border-radius: var(--r-lg);
  padding: var(--sp-3);
  margin-bottom: var(--sp-2);
  box-shadow: var(--sh-1);
}

.card--fill   { background: var(--fill); border-color: var(--fill); }
.card--accent { background: var(--accent-2); border-color: var(--accent); }
.card--warn   { background: var(--warn-2); border-color: var(--warn); }
.card--ok     { background: var(--ok-2); border-color: var(--ok); }
.card--err    { background: var(--err-2); border-color: var(--err); }
.card--dark   { background: #0f172a; border-color: #0f172a; color: #cbd5e1; }
.card--dashed { border-style: dashed; border-color: var(--line); background: var(--card); }

.card__title { font-size: var(--fs-md); font-weight: 600; color: var(--ink); }
.card__sub   { font-size: var(--fs-sm); color: var(--ink-3); margin-top: 4rpx; }
.card__body  { font-size: var(--fs-sm); color: var(--ink-2); margin-top: 4rpx; }

/* 模块入口卡（首页四个模块，颜色即导航） */
.mod-card { display: flex; align-items: center; gap: var(--sp-2); padding: var(--sp-3); }
.mod-card__icon { font-size: 36rpx; line-height: 1; }
.mod-card__arrow { color: currentColor; font-size: var(--fs-lg); opacity: 0.6; }
.mod-card--stats    { background: var(--mod-stats-2);   border-color: var(--mod-stats);   color: var(--mod-stats); }
.mod-card--player   { background: var(--mod-player-2);  border-color: var(--mod-player);  color: var(--mod-player); }
.mod-card--tactic   { background: var(--mod-tactic-2);  border-color: var(--mod-tactic);  color: var(--mod-tactic); }
.mod-card--opponent { background: var(--mod-opponent-2);border-color: var(--mod-opponent);color: var(--warn-ink); }
.mod-card .card__title,
.mod-card .card__sub { color: inherit; }
.mod-card .card__sub { opacity: 0.75; }

/* ============================================================
   按钮
   ============================================================ */

.btn {
  display: flex; align-items: center; justify-content: center;
  padding: var(--sp-2) var(--sp-4);
  border-radius: var(--r-md);
  font-size: var(--fs-md); font-weight: 500;
  line-height: 1.4;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}
.btn--block { width: 100%; }
.btn--sm { padding: var(--sp-1) var(--sp-2); font-size: var(--fs-sm); }
.btn--primary { background: var(--accent); color: #fff; }
.btn--ghost { background: transparent; border-color: var(--line); color: var(--ink-2); }
.btn--danger { background: var(--err); color: #fff; }
.btn--danger-ghost { background: transparent; border-color: var(--err-2); color: var(--err); }
.btn--disabled { background: var(--fill); color: var(--ink-3); border-color: var(--line-2); }

/* 录制页的结束按钮 */
.btn--rec {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: var(--err); color: #fff; font-size: 40rpx;
  box-shadow: 0 0 0 12rpx rgba(220, 38, 38, 0.18);
}

/* ============================================================
   徽章 / 标签
   ============================================================ */

.chip {
  display: inline-flex; align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--r-pill);
  font-size: var(--fs-xs);
  background: var(--fill); color: var(--ink-2);
  line-height: 1.6;
}
.chip--accent { background: var(--accent-2); color: var(--accent); }
.chip--ok     { background: var(--ok-2);     color: #14532d; }
.chip--warn   { background: var(--warn-2);   color: var(--warn-ink); }
.chip--err    { background: var(--err-2);    color: var(--err-ink); }
.chip--muted  { background: var(--fill);     color: var(--ink-3); }
.chip--tactic { background: var(--mod-tactic-2); color: var(--mod-tactic); }
.chip--player { background: var(--mod-player-2); color: #115e59; }

/* 数据来源徽章 */
.src { display: inline-flex; align-items: center; gap: 4rpx;
       font-size: var(--fs-xs); padding: 2rpx 12rpx; border-radius: var(--r-pill); }
.src--ai     { background: var(--src-ai-2);     color: var(--src-ai); }
.src--manual { background: var(--src-manual-2); color: var(--src-manual); }
.src--mixed  { background: var(--src-mixed-2);  color: var(--src-mixed); }

/* 筛选 chip */
.fchip {
  display: inline-flex; align-items: center;
  padding: var(--sp-1) var(--sp-3);
  background: var(--card); border: 2rpx solid var(--line);
  border-radius: var(--r-pill);
  font-size: var(--fs-sm); color: var(--ink-2);
}
.fchip--on { background: var(--ink); border-color: var(--ink); color: #fff; }

/* ============================================================
   分段控件 / 选项格子
   ============================================================ */

.seg {
  display: flex; border: 2rpx solid var(--line);
  border-radius: var(--r-md); overflow: hidden; margin-bottom: var(--sp-2);
}
.seg__item {
  flex: 1; text-align: center; padding: var(--sp-2) 0;
  font-size: var(--fs-sm); color: var(--ink-2); background: var(--card);
}
.seg__item--on { background: var(--accent); color: #fff; font-weight: 500; }
.seg--tactic .seg__item--on { background: var(--mod-tactic); }

/* 选项格子（年龄段 / 赛制） */
.optgrid { display: flex; gap: var(--sp-1); margin-bottom: var(--sp-1); }
.optgrid--5 .opt { flex: 1; }
.optgrid--4 .opt { flex: 1; }
.opt {
  border: 2rpx solid var(--line); border-radius: var(--r-sm);
  padding: var(--sp-1) 4rpx; text-align: center;
  font-size: var(--fs-xs); color: var(--ink-2); background: var(--card);
  line-height: 1.3;
}
.opt--on { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 500; }
.opt--disabled { background: var(--fill); color: var(--ink-3); }

/* 选中后的后果提示行（PRD 屏 02：让教练理解而非机械点选） */
.hint {
  font-size: var(--fs-xs); color: var(--accent);
  background: var(--accent-2); border-radius: var(--r-sm);
  padding: var(--sp-1) var(--sp-2); margin: var(--sp-1) 0 var(--sp-2);
  line-height: 1.5;
}
.hint--warn { color: var(--warn-ink); background: var(--warn-2); }
.hint__sub { opacity: 0.75; }

/* ============================================================
   表单
   ============================================================ */

.field {
  border: 2rpx solid var(--line-2); border-radius: var(--r-sm);
  padding: var(--sp-2); margin-bottom: var(--sp-2);
  background: var(--card);
}
.field__label { font-size: var(--fs-xs); color: var(--ink-3); margin-bottom: 4rpx; }
.field__input { font-size: var(--fs-md); color: var(--ink); width: 100%; }
.field__placeholder { color: var(--ink-3); }

/* ============================================================
   列表项
   ============================================================ */

.item {
  display: flex; align-items: center; gap: var(--sp-2);
  background: var(--card); border: 2rpx solid var(--line-2);
  border-radius: var(--r-md); padding: var(--sp-2);
  margin-bottom: var(--sp-1);
}
.item--pending { border-color: var(--warn); background: #fffbeb; }
.item--dashed { border-style: dashed; }
.item--dim { opacity: 0.6; }
.item__avatar {
  width: 68rpx; height: 68rpx; border-radius: 50%;
  background: var(--fill-2); flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: var(--fs-sm); font-weight: 600; color: var(--ink-2);
}
.item__avatar--accent { background: var(--accent-2); color: var(--accent); }
.item__avatar--ok { background: var(--ok-2); color: var(--ok); }
.item__avatar--err { background: var(--err-2); color: var(--err); }
.item__avatar--warn { background: var(--warn-2); color: var(--warn-ink); }
.item__val { text-align: right; flex-shrink: 0; }
.item__val-n { font-size: var(--fs-lg); font-weight: 600; color: var(--ink); }
.item__val-l { font-size: var(--fs-xs); color: var(--ink-3); }

/* ============================================================
   数据格子
   ============================================================ */

.statgrid { display: flex; gap: var(--sp-1); margin-bottom: var(--sp-2); }
.statgrid--3 .stat { flex: 1; }
.statgrid--4 .stat { flex: 1; }
.stat {
  background: var(--card); border: 2rpx solid var(--line-2);
  border-radius: var(--r-md); padding: var(--sp-2) 4rpx; text-align: center;
}
.stat__n { font-size: var(--fs-lg); font-weight: 600; color: var(--ink); }
.stat__l { font-size: var(--fs-xs); color: var(--ink-3); margin-top: 2rpx; }
/* 数据缺失时用 -- 而非 0（PRD 3.6：0 会被误读为"得分为 0"） */
.stat__n--na { color: var(--ink-3); }

/* 进度条（补录进度、阵型分布） */
.prog { display: flex; align-items: center; gap: var(--sp-1); font-size: var(--fs-xs); margin-bottom: 6rpx; }
.prog__name { width: 120rpx; color: var(--ink-2); flex-shrink: 0; }
.prog__track { flex: 1; height: 14rpx; background: var(--fill); border-radius: 7rpx; overflow: hidden; }
.prog__fill { height: 100%; background: var(--accent); border-radius: 7rpx; }
.prog__fill--warn { background: var(--warn); }
.prog__fill--ok { background: var(--ok); }
.prog__fill--muted { background: var(--ink-3); }
.prog__v { width: 64rpx; text-align: right; color: var(--ink-2); }

/* ============================================================
   底部弹层（PRD 3.4：点事件卡=底部弹层，不用新页面）
   ============================================================ */

.sheet-mask {
  position: fixed; inset: 0; background: rgba(15, 23, 42, 0.45);
  z-index: 100;
}
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 101;
  background: var(--card);
  border-radius: var(--r-xl) var(--r-xl) 0 0;
  box-shadow: var(--sh-sheet);
  padding: var(--sp-3) var(--sp-3) calc(var(--sp-3) + var(--safe-bottom));
  max-height: 78vh; overflow-y: auto;
}
.sheet__handle {
  width: 72rpx; height: 8rpx; background: var(--line-2);
  border-radius: 4rpx; margin: 0 auto var(--sp-3);
}
.sheet__title { font-size: var(--fs-md); font-weight: 600; margin-bottom: var(--sp-2); }

/* ============================================================
   空状态（PRD 3.6：空状态永远有 CTA）
   ============================================================ */

.empty { padding: 120rpx var(--sp-4); text-align: center; }
.empty__icon {
  width: 120rpx; height: 120rpx; margin: 0 auto var(--sp-3);
  border: 3rpx dashed var(--line); border-radius: var(--r-lg);
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx; color: var(--ink-3);
}
.empty__title { font-size: var(--fs-md); color: var(--ink-2); margin-bottom: var(--sp-1); }
.empty__desc { font-size: var(--fs-sm); color: var(--ink-3); margin-bottom: var(--sp-4); line-height: 1.6; }

/* ============================================================
   告警条（契约 warnings 非空时必须显示）
   ============================================================ */

.alert { padding: var(--sp-2) var(--sp-3); border-radius: var(--r-md);
         font-size: var(--fs-sm); margin-bottom: var(--sp-2); line-height: 1.5; }
.alert--warn { background: var(--warn-2); color: var(--warn-ink); }
.alert--err  { background: var(--err-2);  color: var(--err-ink); }
.alert--info { background: var(--accent-2); color: #1e3a8a; }

/* ============================================================
   口径标识（PRD 9.4 #4.8：必须常驻）
   ============================================================ */

.scope {
  font-size: var(--fs-xs); color: var(--ink-3);
  background: var(--fill); border-radius: var(--r-sm);
  padding: 6rpx var(--sp-2); margin-bottom: var(--sp-2);
}
.scope--strong { color: var(--accent); background: var(--accent-2); }

/* ============================================================
   底部导航
   ============================================================ */

.tabbar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 50;
  display: flex; background: var(--card);
  border-top: 2rpx solid var(--line-2);
  padding-bottom: var(--safe-bottom);
}
.tabbar__item {
  flex: 1; text-align: center; padding: var(--sp-1) 0;
  font-size: var(--fs-xs); color: var(--ink-3);
}
.tabbar__item--on { color: var(--accent); font-weight: 600; }
.tabbar__icon { font-size: 36rpx; line-height: 1.2; display: block; }

/* ============================================================
   REC 徽章（录制页）
   ============================================================ */

.rec {
  display: inline-flex; align-items: center; gap: 8rpx;
  background: var(--err); color: #fff;
  padding: 4rpx 16rpx; border-radius: var(--r-pill);
  font-size: var(--fs-xs); font-weight: 500;
}
.rec__dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #fff; }
.rec__dot--blink { animation: rec-blink 1.5s infinite; }
@keyframes rec-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }

/* ============================================================
   视频卡
   ============================================================ */

.vcard {
  position: relative; width: 100%;
  background: #1e293b; border-radius: var(--r-md);
  overflow: hidden;
}
.vcard--16x9 { padding-top: 56.25%; }
.vcard__play {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: rgba(255, 255, 255, 0.92); color: var(--ink);
  display: flex; align-items: center; justify-content: center; font-size: 28rpx;
}
.vcard__dur {
  position: absolute; right: 12rpx; bottom: 12rpx;
  background: rgba(0, 0, 0, 0.65); color: #fff;
  font-size: var(--fs-xs); padding: 2rpx 10rpx; border-radius: 4rpx;
}
.vcard__tag {
  position: absolute; left: 12rpx; top: 12rpx;
  background: rgba(255, 255, 255, 0.9); color: var(--ink);
  font-size: var(--fs-xs); padding: 2rpx 12rpx; border-radius: 4rpx;
}
